datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Owner mobile ("JCT Pocket") + desktop register shared ledger
model PocketTransaction {
  id            String   @id @default(cuid())
  branch        String   // JCT_HQ | HEMPEL_JUBAIL | JOTUN_DAMMAM | SIGMA_JUBAIL
  type          String   // EXPENSE | ADVANCE | CREDIT_COLLECTION
  amount        Float
  category      String?
  recipientName String?
  paymentSource String   // DRAWER_CASH | OWNER_POCKET | BANK_TRANSFER
  paymentMode   String?  // e.g., "SAB", "AL_RAJHI", "SNB", "VISA", "MADA", "BANK_TRANSFER", "CASH"
  note          String?
  date          String   // YYYY-MM-DD
  createdAt     DateTime @default(now())

  @@index([branch, date])
}

model DailyRegisterLock {
  id          String   @id @default(cuid())
  branch      String
  date        String
  closingCash Float
  openingCash Float    @default(2634)
  inflows     Float    @default(0)
  bankSwipes  Float    @default(0)
  outflows    Float    @default(0)
  posFees     Float    @default(0)
  madaFees    Float    @default(0)
  ccFees      Float    @default(0)
  lockedAt    DateTime @default(now())
  lockedBy    String
  status      String   @default("LOCKED")
  dataJson    String?

  @@index([branch, date])
}


model DailyRegister {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  branch      String   // "Jubail Main", "Dammam", "Sigma"
  cashIn      Float    @default(0)
  cashOut     Float    @default(0)
  closingCash Float    @default(0)
  paymentMode String?  // e.g., "SAB", "AL_RAJHI", "SNB", "VISA", "MADA", "BANK_TRANSFER", "CASH"
  notes       String?
  createdAt   DateTime @default(now())
}

model CreditCustomer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  totalDue    Float    @default(0)
  status      String   @default("CURRENT") // CURRENT, OVERDUE, HIGH_RISK
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model SupplierBill {
  id          String   @id @default(cuid())
  supplier    String   // "Jotun KSA", "Hempel", "Sigma"
  invoiceNo   String
  amount      Float
  dueDate     DateTime
  isPaid      Boolean  @default(false)
  paymentMode String?  // e.g., "SAB", "AL_RAJHI", "SNB", "VISA", "MADA", "BANK_TRANSFER", "CASH"
  createdAt   DateTime @default(now())
}


model Staff {
  id           String        @id @default(cuid())
  name         String
  branch       String        // e.g., "JCT_HQ", "HEMPEL_JUBAIL", "JOTUN_DAMMAM", "SIGMA_JUBAIL"
  role         String?       // "Cashier", "Sales", "Driver", "Warehouse"
  baseSalary   Float         @default(0.0)
  phone        String?
  iqamaNumber  String?
  status       String        @default("ACTIVE") // "ACTIVE" or "ARCHIVED"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  payrollLogs  PayrollLog[]
}

model PayrollLog {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type        String   // "SALARY_PAYOUT", "ADVANCE", "BONUS", "DEDUCTION"
  amount      Float
  date        String   // Format: "YYYY-MM-DD"
  branch      String
  note        String?
  source      String   @default("REGISTER_DRAWER") // or "BANK_TRANSFER", "OWNER_POCKET"
  paymentMode String?  // e.g., "SAB", "AL_RAJHI", "SNB", "VISA", "MADA", "BANK_TRANSFER", "CASH"
  createdAt   DateTime @default(now())

  @@index([staffId])
  @@index([branch])
  @@index([date])
}
