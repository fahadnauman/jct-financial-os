datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Owner mobile ("JCT Pocket") + desktop register shared ledger
model PocketTransaction {
  id             String   @id @default(cuid())
  branch         String   // JCT_HARDWARE_JOTUN | HEMPEL | DAMMAM_JOTUN | SIGMA
  type           String   // EXPENSE | ADVANCE | CREDIT_COLLECTION
  amount         Float
  originalAmount Float?
  isEdited       Boolean  @default(false)
  isReturned     Boolean  @default(false)
  discountAmount Float?   @default(0)
  roundOffAmount Float?   @default(0)
  businessCommission Float? @default(0)
  netPayableAmount Float?
  overrideReason String?  // "BUSINESS_COMMISSION", "BILL_MISTAKE", "CUSTOM"
  overrideNote   String?
  category       String?
  recipientName  String?
  paymentSource  String   // DRAWER_CASH | OWNER_POCKET | BANK_TRANSFER
  paymentMode    String?  // e.g., "SAB", "AL_RAJHI", "SNB", "VISA", "MADA", "BANK_TRANSFER", "CASH"
  supplierInvoiceNum String?
  billPdfUrl     String?
  receiptUrl     String?
  followUpDate   String?
  followUpStatus String?  @default("SCHEDULED")
  note           String?
  date           String   // YYYY-MM-DD
  createdAt      DateTime @default(now())

  @@index([branch, date])
}

model DailyRegisterLock {
  id                 String   @id @default(cuid())
  branch             String
  date               String
  closingCash        Float
  openingCash        Float    @default(2634)
  takeHomeAmount     Float?
  nextDayOpeningCash Float?
  inflows            Float    @default(0)
  bankSwipes         Float    @default(0)
  outflows           Float    @default(0)
  posFees            Float    @default(0)
  madaFees           Float    @default(0)
  ccFees             Float    @default(0)
  lockedAt           DateTime @default(now())
  lockedBy           String
  status             String   @default("LOCKED")
  auditStatus        String   @default("LOCKED")
  hasDiscrepancy     Boolean  @default(false)
  varianceAmount     Float?
  varianceType       String?
  dataJson           String?

  @@index([branch, date])
}


model DailyRegister {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  branch         String   // "Jubail Main", "Dammam", "Sigma"
  cashIn         Float    @default(0)
  cashOut        Float    @default(0)
  closingCash    Float    @default(0)
  originalAmount Float?
  isEdited       Boolean  @default(false)
  overrideReason String?  // "BUSINESS_COMMISSION", "BILL_MISTAKE", "CUSTOM"
  overrideNote   String?
  paymentMode    String?  // e.g., "SAB", "AL_RAJHI", "SNB", "VISA", "MADA", "BANK_TRANSFER", "CASH"
  auditStatus    String   @default("LOCKED")
  hasDiscrepancy Boolean  @default(false)
  varianceAmount Float?
  varianceType   String?
  notes          String?
  createdAt      DateTime @default(now())
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNo      String
  customer       String?
  amount         Float
  originalAmount Float?
  isEdited       Boolean  @default(false)
  isReturned     Boolean  @default(false)
  discountAmount Float?   @default(0)
  roundOffAmount Float?   @default(0)
  businessCommission Float? @default(0)
  netPayableAmount Float?
  overrideReason String?  // "BUSINESS_COMMISSION", "BILL_MISTAKE", "CUSTOM"
  overrideNote   String?
  paymentMode    String?  // e.g., "SAB", "AL_RAJHI", "SNB", "VISA", "MADA", "BANK_TRANSFER", "CASH"
  posTerminal    String?
  followUpDate   String?
  followUpStatus String?  @default("SCHEDULED")
  branch         String?
  date           String?
  createdAt      DateTime @default(now())

  @@index([invoiceNo])
}

model CreditCustomer {
  id                 String   @id @default(cuid())
  name               String
  phone              String?
  totalDue           Float    @default(0)
  outstandingBalance Float?   @default(0)
  linkedInvoiceNum   String?
  followUpDate       String?
  followUpStatus     String?  @default("SCHEDULED")
  status             String   @default("CURRENT") // CURRENT, OVERDUE, HIGH_RISK
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model CreditRadar {
  id                 String   @id @default(cuid())
  customerName       String
  linkedInvoiceNum   String?
  invoiceNo          String?
  originalDate       String?
  followUpDate       String?
  followUpStatus     String?  @default("SCHEDULED")
  amount             Float    @default(0)
  outstandingBalance Float    @default(0)
  status             String   @default("CURRENT")
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@index([linkedInvoiceNum])
  @@index([customerName])
}

model SupplierBill {
  id                 String   @id @default(cuid())
  supplier           String   // "Jotun KSA", "Hempel", "Sigma"
  invoiceNo          String
  supplierInvoiceNum String?
  billPdfUrl         String?
  receiptUrl         String?
  amount             Float
  originalAmount     Float?
  isReturned         Boolean  @default(false)
  dueDate            DateTime
  followUpDate       String?
  followUpStatus     String?  @default("SCHEDULED")
  isPaid             Boolean  @default(false)
  paymentMode        String?  // e.g., "SAB", "AL_RAJHI", "SNB", "VISA", "MADA", "BANK_TRANSFER", "CASH"
  createdAt          DateTime @default(now())
}

model Purchase {
  id                 String   @id @default(cuid())
  branch             String   @default("JCT_HARDWARE_JOTUN")
  supplier           String
  supplierInvoiceNum String?
  billPdfUrl         String?
  receiptUrl         String?
  amount             Float
  originalAmount     Float?
  isReturned         Boolean  @default(false)
  category           String   @default("Credit Purchase")
  dueDate            String?
  followUpDate       String?
  followUpStatus     String?  @default("SCHEDULED")
  paymentMode        String?
  date               String
  createdAt          DateTime @default(now())
}

model Expense {
  id                 String   @id @default(cuid())
  branch             String   @default("JCT_HARDWARE_JOTUN")
  title              String
  category           String
  supplierName       String?
  supplierInvoiceNum String?
  billPdfUrl         String?
  receiptUrl         String?
  amount             Float
  originalAmount     Float?
  isReturned         Boolean  @default(false)
  paymentMode        String?
  date               String
  createdAt          DateTime @default(now())
}


model Staff {
  id           String        @id @default(cuid())
  name         String
  branch       String        // e.g., "JCT_HARDWARE_JOTUN", "HEMPEL", "DAMMAM_JOTUN", "SIGMA"
  role         String?       // "Cashier", "Sales", "Driver", "Warehouse"
  baseSalary   Float         @default(0.0)
  phone        String?
  iqamaNumber  String?
  status       String        @default("ACTIVE") // "ACTIVE" or "ARCHIVED"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  payrollLogs  PayrollLog[]
}

model PayrollLog {
  id              String   @id @default(cuid())
  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type            String   // "SALARY", "SALARY_PAYOUT", "ADVANCE_SALARY", "ADVANCE", "STAFF_LOAN", "BONUS", "DEDUCTION"
  amount          Float
  deductionAmount Float?   @default(0)
  netAmount       Float?
  date            String   // Format: "YYYY-MM-DD"
  branch          String
  note            String?
  source          String   @default("REGISTER_DRAWER") // or "BANK_TRANSFER", "OWNER_POCKET"
  paymentMode     String?  // e.g., "SAB", "AL_RAJHI", "SNB", "VISA", "MADA", "BANK_TRANSFER", "CASH"
  createdAt       DateTime @default(now())

  @@index([staffId])
  @@index([branch])
  @@index([date])
}

// Live multi-device Daily Register session (one active draft per branch)
model ActiveRegisterSession {
  id         String   @id @default(cuid())
  branch     String   @unique // JCT_HARDWARE_JOTUN | HEMPEL | DAMMAM_JOTUN | SIGMA
  status     String   @default("DRAFT") // DRAFT | IN_PROGRESS | CLEARED | COMPLETED
  reportDate String?
  dataJson   String?  // { erpInvoices, preLoggedBankInvoices, preLoggedEntries, reportDate }
  revision   Int      @default(0)
  updatedBy  String?  // client/device id that wrote the latest revision
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// Per-branch opening baseline (initial setup) used as the starting point for cash & bank totals
model BranchSettings {
  id                 String   @id @default(cuid())
  branch             String   @unique // JCT_HARDWARE_JOTUN | HEMPEL | DAMMAM_JOTUN | SIGMA
  openingCashBalance Float    @default(0)
  openingBankBalance Float    @default(0)
  updatedBy          String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

// Manual Cash & Bank Capital Deposits / Injections in Settings Module
model CapitalDeposit {
  id            String   @id @default(cuid())
  branch        String   @default("JCT_HARDWARE_JOTUN")
  targetAccount String   @default("CASH") // "CASH" | "BANK"
  amount        Float
  date          String   // YYYY-MM-DD (Saudi AST)
  notes         String?
  createdBy     String   @default("OWNER")
  createdAt     DateTime @default(now())

  @@index([branch, date])
  @@index([targetAccount])
}

// Intelligent Customer & Supplier Advance Ledger
model AdvanceRecord {
  id                 String   @id @default(cuid())
  branch             String   @default("JCT_HARDWARE_JOTUN")
  direction          String   // "CUSTOMER_ADVANCE_IN" | "SUPPLIER_ADVANCE_OUT"
  partyName          String
  phoneOrRef         String?
  branchInvNo        String?
  totalAdvanceAmount Float
  utilizedAmount     Float    @default(0)
  remainingBalance   Float
  paymentMode        String   @default("CASH") // "CASH" | "BANK" | "CARD" | "SAB" | "AL_RAJHI" | "SNB" | "BANK_TRANSFER"
  date               String   // YYYY-MM-DD (Saudi AST)
  followUpDate       String?  // YYYY-MM-DD
  followUpStatus     String?  @default("SCHEDULED") // "PENDING" | "SCHEDULED" | "COMPLETED"
  notes              String?
  status             String   @default("ACTIVE") // "ACTIVE" | "ADJUSTED" | "REFUNDED"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([branch, direction, status])
  @@index([partyName])
}

